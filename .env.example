# Server-only. Never use a VITE_ prefix for a secret.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-6.1-terra
OPENAI_PRICING_MODEL=gpt-6.1-sol
# Concurrent primary valuation jobs; clamped to 1..12.
PRICING_CONCURRENCY=10
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# Default-model rate snapshot 2026-10-29, USD per 1M tokens. Change when changing models.
# https://developers.openai.com/api/docs/pricing — cached input billed at full rate here (conservative estimate).
VISION_INPUT_USD_PER_MILLION=1
VISION_OUTPUT_USD_PER_MILLION=5
# Use HTTPS for camera/mic on a phone. See README for trusting the local certificate.
DEV_HTTPS=false
PORT=8787
HOST=127.0.0.1
DATA_DIR=./data
MAX_SWEEP_FRAMES=90
FINALIZATION_TIMEOUT_MS=240000
# Optional pricing estimates; fill from current provider pricing.
PRICING_INPUT_USD_PER_MILLION=2
PRICING_OUTPUT_USD_PER_MILLION=10
WEB_SEARCH_USD_PER_CALL=0.01

OPENAI_VISION_REASONING_EFFORT=medium

OPENAI_PRICING_REASONING_EFFORT=low
